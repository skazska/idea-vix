{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Rust Server",
            "cwd": "${workspaceFolder}/server/ws",
            "cargo": {
                "args": [
                    "build",
                    "--manifest-path=${workspaceFolder}/server/ws/Cargo.toml",
                    "--bin=ws",
                    "--package=ws"
                ],
                "cwd": "${workspaceFolder}/server/ws",
                "filter": {
                    "name": "ws",
                    "kind": "bin"
                }
            },
